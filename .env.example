# ==============================================================================
# AI Personal Study & Interview Assistant — Environment Variables Template
# ------------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# NEVER commit your actual ".env" file to version control.
# ==============================================================================

# --- GEMINI API ---
# Get your key from: https://console.groq.com/keys
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use for chat/completions (cost vs quality tradeoff)
# Options: gemini-3.6-flash, gemini-2.5pro
GEMINI_MODEL=gemini-3.6-flash
# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.4

# Max tokens per completion response
GEMINI_MAX_TOKENS=2048

# --- Embedding Model (local, via Sentence Transformers — no API key needed) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Vector Store ---
VECTOR_DB_DIR=vector_db
FAISS_INDEX_NAME=study_assistant_index

# --- SQLite Database ---
SQLITE_DB_PATH=database/study_assistant.db

# --- File Storage ---
UPLOAD_DIR=uploads
NOTES_DIR=notes
DATA_DIR=data

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# --- App Settings ---
APP_NAME=AI Personal Study & Interview Assistant
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
